<Window x:Class="TaskTree.UI.Views.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:TaskTree.Core.Enums;assembly=TaskTree.Core"
             xmlns:views="clr-namespace:TaskTree.UI.Views"
        Title="TaskTree"
        Width="820" Height="720"
        WindowStyle="ThreeDBorderWindow"
        ShowInTaskbar="True"
        Background="{DynamicResource TaskTreeWindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TaskTree.UI;component/Themes/ThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8">
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding QuickAddCommand}" Width="60" Margin="4,0,0,0" />
            <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <GroupBox Grid.Row="1" Header="New structured task" Margin="8,0,8,8" Background="{DynamicResource TaskTreePanelBackgroundBrush}" BorderBrush="{DynamicResource TaskTreePanelBorderBrush}" Padding="{DynamicResource TaskTreePanelPadding}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Builder.Title, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Patient text" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Builder.PatientText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,8,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Lab hint" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Builder.LabHint, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Delivery hint" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Builder.DeliveryHint, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,8,0" />
                <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="Lab review" IsChecked="{Binding Builder.RequiresLabReview}" Margin="0,6,0,0" />
                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Delivery coordination" IsChecked="{Binding Builder.RequiresDeliveryCoordination}" Margin="0,8,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Builder.StatusMessage}" Margin="150,8,8,0" Foreground="{DynamicResource TaskTreeMutedTextBrush}" />
                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Create" Command="{Binding Builder.CreateTaskCommand}" Width="70" Margin="0,0,6,0" />
                    <Button Content="Reset" Command="{Binding Builder.ResetFormCommand}" Width="70" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <views:SettingsView Grid.Row="2" Margin="8,0,8,8" DataContext="{Binding Settings}" />

        <TreeView Grid.Row="3" ItemsSource="{Binding Tasks}" Margin="8,0,8,0"
                  HorizontalContentAlignment="Stretch">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <Style x:Key="PriorityTextStyle" TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Priority}" Value="{x:Static enums:Priority.Critical}">
                            <Setter Property="Foreground" Value="{DynamicResource TaskTreePriorityCriticalBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Priority}" Value="{x:Static enums:Priority.High}">
                            <Setter Property="Foreground" Value="{DynamicResource TaskTreePriorityHighBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Priority}" Value="{x:Static enums:Priority.Normal}">
                            <Setter Property="Foreground" Value="{DynamicResource TaskTreePriorityNormalBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Priority}" Value="{x:Static enums:Priority.Low}">
                            <Setter Property="Foreground" Value="{DynamicResource TaskTreePriorityLowBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Priority}" Value="{x:Static enums:Priority.Trivial}">
                            <Setter Property="Foreground" Value="{DynamicResource TaskTreePriorityTrivialBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}" DataType="{x:Type local:TaskNode}" xmlns:local="clr-namespace:TaskTree.Core.Models;assembly=TaskTree.Core">
                    <Grid MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Priority}" Style="{StaticResource PriorityTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Deadline, StringFormat='MMM dd HH:mm', TargetNullValue='-'}" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="Delete" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="8,0,0,0" />
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
        <StatusBar Grid.Row="4"><StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem></StatusBar>
    </Grid>
</Window>
