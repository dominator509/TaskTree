<Window x:Class="TaskTree.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:TaskTree.Core.Enums;assembly=TaskTree.Core"
        Title="TaskTree"
        Width="820" Height="720"
        WindowStyle="ThreeDBorderWindow"
        ShowInTaskbar="True"
        Background="{DynamicResource TaskTreeWindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TaskTree.UI;component/Themes/ThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="ThemePreferenceValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="enums:ThemePreference" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8">
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding QuickAddCommand}" Width="60" Margin="4,0,0,0" />
            <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <GroupBox Grid.Row="1" Header="New structured task" Margin="8,0,8,8" Background="{DynamicResource TaskTreePanelBackgroundBrush}" BorderBrush="{DynamicResource TaskTreePanelBorderBrush}" Padding="{DynamicResource TaskTreePanelPadding}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Builder.Title, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Patient text" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Builder.PatientText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,8,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Lab hint" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Builder.LabHint, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Delivery hint" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Builder.DeliveryHint, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,8,0" />
                <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="Lab review" IsChecked="{Binding Builder.RequiresLabReview}" Margin="0,6,0,0" />
                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Delivery coordination" IsChecked="{Binding Builder.RequiresDeliveryCoordination}" Margin="0,8,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Builder.StatusMessage}" Margin="150,8,8,0" Foreground="{DynamicResource TaskTreeMutedTextBrush}" />
                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Create" Command="{Binding Builder.CreateTaskCommand}" Width="70" Margin="0,0,6,0" />
                    <Button Content="Reset" Command="{Binding Builder.ResetFormCommand}" Width="70" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Settings" Margin="8,0,8,8" Background="{DynamicResource TaskTreePanelBackgroundBrush}" BorderBrush="{DynamicResource TaskTreePanelBorderBrush}" Padding="{DynamicResource TaskTreePanelPadding}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Source={StaticResource ThemePreferenceValues}}" SelectedItem="{Binding Settings.ThemePreference}" />
                <CheckBox Grid.Row="0" Grid.Column="2" Content="Start with Windows" IsChecked="{Binding Settings.StartWithWindows}" Margin="12,0,0,0" />
                <CheckBox Grid.Row="0" Grid.Column="3" Content="Minimize to tray" IsChecked="{Binding Settings.MinimizeToTrayOnClose}" Margin="12,0,0,0" />
                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Enable reminder sounds" IsChecked="{Binding Settings.EnableReminderSounds}" Margin="0,8,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Snooze minutes" VerticalAlignment="Center" Margin="12,8,0,0" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Settings.ReminderSnoozeMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="12,8,0,0" />
                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Show completed tasks" IsChecked="{Binding Settings.ShowCompletedTasks}" Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Settings.StatusMessage}" Foreground="{DynamicResource TaskTreeMutedTextBrush}" Margin="20,8,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Load" Command="{Binding Settings.LoadCommand}" Width="70" Margin="0,0,6,0" />
                    <Button Content="Save" Command="{Binding Settings.SaveCommand}" Width="70" Margin="0,0,6,0" />
                    <Button Content="Reset" Command="{Binding Settings.ResetCommand}" Width="70" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8,0,8,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100" />
                <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline, StringFormat='MMM dd HH:mm', TargetNullValue='-'}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
        <StatusBar Grid.Row="4"><StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem></StatusBar>
    </Grid>
</Window>
