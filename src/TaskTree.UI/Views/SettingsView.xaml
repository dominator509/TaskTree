<UserControl x:Class="TaskTree.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:TaskTree.Core.Enums;assembly=TaskTree.Core"
             Background="Transparent">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="ThemePreferenceValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}"
                            xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:ThemePreference" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <GroupBox Header="Settings"
              Background="{DynamicResource TaskTreePanelBackgroundBrush}"
              BorderBrush="{DynamicResource TaskTreePanelBorderBrush}"
              Padding="{DynamicResource TaskTreePanelPadding}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding Source={StaticResource ThemePreferenceValues}}"
                      SelectedItem="{Binding ThemePreference}" />
            <CheckBox Grid.Row="0" Grid.Column="2" Content="Start with Windows"
                      IsChecked="{Binding StartWithWindows}" Margin="12,0,0,0" />
            <CheckBox Grid.Row="0" Grid.Column="3" Content="Minimize to tray"
                      IsChecked="{Binding MinimizeToTrayOnClose}" Margin="12,0,0,0" />
            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Enable reminder sounds" IsChecked="{Binding EnableReminderSounds}"
                      Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Snooze minutes"
                       VerticalAlignment="Center" Margin="12,8,0,0" />
            <TextBox Grid.Row="1" Grid.Column="3"
                     Text="{Binding ReminderSnoozeMinutes, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" HorizontalAlignment="Left" Margin="12,8,0,0" />
            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Show completed tasks" IsChecked="{Binding ShowCompletedTasks}"
                      Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TaskTreeMutedTextBrush}" Margin="20,8,0,0" />
            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Load" Command="{Binding LoadCommand}" Width="70" Margin="0,0,6,0" />
                <Button Content="Save" Command="{Binding SaveCommand}" Width="70" Margin="0,0,6,0" />
                <Button Content="Reset" Command="{Binding ResetCommand}" Width="70" />
            </StackPanel>
        </Grid>
    </GroupBox>
</UserControl>
