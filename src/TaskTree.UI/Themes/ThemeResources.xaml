<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SPEC-DERIVED-PHASE2D: Theme resources (HALT #1/#2/#8/#11/#13). -->

    <!-- Priority brushes. Keep synchronized with PriorityBrushProvider.cs until Phase 5C converter/resource lookup decision (Gap #143). -->
    <SolidColorBrush x:Key="TaskTreePriorityCriticalBrush" Color="#D13438" />
    <SolidColorBrush x:Key="TaskTreePriorityHighBrush" Color="#FF8C00" />
    <SolidColorBrush x:Key="TaskTreePriorityNormalBrush" Color="#FFD700" />
    <SolidColorBrush x:Key="TaskTreePriorityLowBrush" Color="#4F9DE8" />
    <SolidColorBrush x:Key="TaskTreePriorityTrivialBrush" Color="#8A8886" />

    <!-- Surface brushes. -->
    <SolidColorBrush x:Key="TaskTreeWindowBackgroundBrush" Color="#FFF7F7F7" />
    <SolidColorBrush x:Key="TaskTreePanelBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TaskTreePanelBorderBrush" Color="#FFD0D0D0" />
    <SolidColorBrush x:Key="TaskTreeMutedTextBrush" Color="#FF666666" />

    <!-- Common dimensions. -->
    <Thickness x:Key="TaskTreePanelPadding">12</Thickness>
    <CornerRadius x:Key="TaskTreePanelCornerRadius">8</CornerRadius>
</ResourceDictionary>
