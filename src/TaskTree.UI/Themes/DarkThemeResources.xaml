<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Runtime dark-theme overrides. Priority and dimension tokens come from the light base dictionary. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TaskTree.UI;component/Themes/ThemeResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="TaskTreeWindowBackgroundBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="TaskTreePanelBackgroundBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="TaskTreePanelBorderBrush" Color="#FF555555" />
    <SolidColorBrush x:Key="TaskTreeMutedTextBrush" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="TaskTreeForegroundBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="TaskTreeInputBackgroundBrush" Color="#FF353535" />
    <SolidColorBrush x:Key="TaskTreeInputBorderBrush" Color="#FF707070" />
</ResourceDictionary>
