<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 1F Msg 1 patches (HALT #12) -->
  <!-- PackageRefs: DI 8.0 + Logging 8.0; ProjectRefs: Core + generated modules + Orchestrator -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TaskTree.App</RootNamespace>
    <AssemblyName>TaskTree.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskTree.Core\TaskTree.Core.csproj" />
    <ProjectReference Include="..\TaskTree.Modules.TaskEngine\TaskTree.Modules.TaskEngine.csproj" />
    <ProjectReference Include="..\TaskTree.Modules.SecureStore\TaskTree.Modules.SecureStore.csproj" />
    <ProjectReference Include="..\TaskTree.Modules.ComplianceCore\TaskTree.Modules.ComplianceCore.csproj" />
    <ProjectReference Include="..\TaskTree.Modules.ReminderScheduler\TaskTree.Modules.ReminderScheduler.csproj" />
    <ProjectReference Include="..\TaskTree.Modules.SessionLock\TaskTree.Modules.SessionLock.csproj" />
    <ProjectReference Include="..\TaskTree.Modules.Settings\TaskTree.Modules.Settings.csproj" />
    <ProjectReference Include="..\TaskTree.Modules.Snooze\TaskTree.Modules.Snooze.csproj" />
    <ProjectReference Include="..\TaskTree.Modules.TrayHost\TaskTree.Modules.TrayHost.csproj" />
    <ProjectReference Include="..\TaskTree.Orchestrator\TaskTree.Orchestrator.csproj" />
  </ItemGroup>

</Project>
