<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 2B Msg 2 patch: add TaskTree.UI ProjectReference for MainWindow/ReminderToast consumption. -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TaskTree.Orchestrator</RootNamespace>
    <AssemblyName>TaskTree.Orchestrator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskTree.Core\TaskTree.Core.csproj" />
    <ProjectReference Include="..\TaskTree.Modules.TrayHost\TaskTree.Modules.TrayHost.csproj" />
    <ProjectReference Include="..\TaskTree.UI\TaskTree.UI.csproj" />
  </ItemGroup>

</Project>
