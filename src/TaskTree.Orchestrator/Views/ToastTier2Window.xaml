<Window x:Class="TaskTree.Orchestrator.Views.ToastTier2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskTree Reminder"
        Width="380" Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Border Background="#FF202020"
            CornerRadius="8"
            Padding="16"
            BorderBrush="#FF606060"
            BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="White" />
            <TextBlock x:Name="MessageText"
                       FontSize="12"
                       Foreground="LightGray"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
