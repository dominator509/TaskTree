<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 4C MSIX packaging scaffold.
  Architecture.md §12: MSIX packaging with Windows App SDK 1.5+ and Authenticode signing.
  Roadmap Phase 4C: TaskTree.Installer.wapproj deliverable.
  Gap #318/#319/#320: validate and normalize on Windows with MSIX packaging tooling after repo stitching.
-->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{7F8D0C4E-7D2F-4A8F-9D40-TASKTREE4C01}</ProjectGuid>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint></PackageCertificateThumbprint>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\TaskTree.App\TaskTree.App.csproj" />
    <ProjectReference Include="..\src\TaskTree.Core\TaskTree.Core.csproj" />
    <ProjectReference Include="..\src\TaskTree.Orchestrator\TaskTree.Orchestrator.csproj" />
    <ProjectReference Include="..\src\TaskTree.UI\TaskTree.UI.csproj" />
    <ProjectReference Include="..\src\TaskTree.Modules.TaskEngine\TaskTree.Modules.TaskEngine.csproj" />
    <ProjectReference Include="..\src\TaskTree.Modules.ReminderScheduler\TaskTree.Modules.ReminderScheduler.csproj" />
    <ProjectReference Include="..\src\TaskTree.Modules.SecureStore\TaskTree.Modules.SecureStore.csproj" />
    <ProjectReference Include="..\src\TaskTree.Modules.ComplianceCore\TaskTree.Modules.ComplianceCore.csproj" />
    <ProjectReference Include="..\src\TaskTree.Modules.TrayHost\TaskTree.Modules.TrayHost.csproj" />
    <ProjectReference Include="..\src\TaskTree.Modules.Settings\TaskTree.Modules.Settings.csproj" />
    <ProjectReference Include="..\src\TaskTree.Modules.SessionLock\TaskTree.Modules.SessionLock.csproj" />
    <ProjectReference Include="..\src\TaskTree.Modules.Snooze\TaskTree.Modules.Snooze.csproj" />
    <ProjectReference Include="..\src\TaskTree.Modules.AutoUpdater\TaskTree.Modules.AutoUpdater.csproj" />
    <ProjectReference Include="..\src\TaskTree.Modules.BugReporter\TaskTree.Modules.BugReporter.csproj" />
  </ItemGroup>

  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')" />
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets')" />
</Project>
